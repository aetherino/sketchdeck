{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "sketchdeck": [
        "./src/schema/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "decks",
    "vite.config.ts"
  ]
}